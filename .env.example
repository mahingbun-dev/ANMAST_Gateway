# ANMAST Gateway 服务端配置示例。复制为 server/.env 或部署时写入 launchd 环境变量。

# 监听地址与端口
HOST=0.0.0.0
PORT=4000

# 数据目录（SQLite 数据库与 Skill 文件存放于此）
# 部署到 Mac Mini 时建议改为绝对路径，如 /Users/you/Library/Application Support/anmast/gateway
DATA_DIR=./data

# 管理员账号（仅首次启动时创建，之后修改密码请在管理界面操作）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# 日志级别 debug | info | warn | error
LOG_LEVEL=info

# 是否需要强制在首次启动后修改默认密码（当前预留）
REQUIRE_PASSWORD_CHANGE=false
